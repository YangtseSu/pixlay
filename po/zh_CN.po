#: data/org.yangtse.Pixlay.desktop.in:3
#: data/org.yangtse.Pixlay.metainfo.xml.in:12
msgid "Pixlay"
msgstr "Pixlay"

#: data/org.yangtse.Pixlay.desktop.in:4
msgid "Photo Collage"
msgstr "照片拼贴"

#: data/org.yangtse.Pixlay.desktop.in:5
#: data/org.yangtse.Pixlay.metainfo.xml.in:13
msgid "Make a collage out of one to nine photos"
msgstr "用一到九张照片做一张拼贴"

#: data/org.yangtse.Pixlay.desktop.in:10
msgid "collage;photo;grid;layout;mosaic;"
msgstr "拼贴;照片;网格;布局;马赛克;"

#: data/org.yangtse.Pixlay.metainfo.xml.in:15
msgid ""
"Pixlay lays photos out on a sheet: add one to nine of them, pick a layout, "
"frame each photo in its cell, give the collage a frame of its own and export "
"the finished image for printing."
msgstr "Pixlay 把照片摆在一张纸上：添加一到九张，选一种布局，为每个格子里的照片调整构图，给整张拼贴加上边框，然后导出成品图用于打印。"

#: data/org.yangtse.Pixlay.metainfo.xml.in:20
msgid "Features:"
msgstr "功能："

#: data/org.yangtse.Pixlay.metainfo.xml.in:22
msgid "Regular and irregular layouts for one to nine photos"
msgstr "一到九张照片的规则与不规则布局"

#: data/org.yangtse.Pixlay.metainfo.xml.in:23
msgid "Pan, zoom and arbitrary rotation for the photo in each cell"
msgstr "每个格子里的照片都能平移、缩放和任意角度旋转"

#: data/org.yangtse.Pixlay.metainfo.xml.in:24
msgid "A frame with its own gap, corner radius and colour"
msgstr "带间距、圆角和颜色的边框"

#: data/org.yangtse.Pixlay.metainfo.xml.in:25
msgid "Export to PNG or JPEG at a long edge of your choice"
msgstr "按自选的长边像素数导出 PNG 或 JPEG"

#: data/org.yangtse.Pixlay.metainfo.xml.in:32
msgid "Yangtse Su"
msgstr "Yangtse Su"
