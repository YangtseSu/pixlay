<?xml version="1.0" encoding="UTF-8"?>
<!-- The AppStream metainfo template (S16). The installed file is
     /usr/share/metainfo/org.yangtse.Pixlay.metainfo.xml, generated by
     msgfmt's XML mode from this template plus the translations in po/ — which is
     why the file name, the <id> and the desktop file's own name are all
     `org.yangtse.Pixlay`. The texts are extracted with the metainfo ITS rules
     (po/extract-pot), and the release version is the workspace's own. -->
<component type="desktop-application">
  <id>org.yangtse.Pixlay</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Pixlay</name>
  <summary>Make a collage out of one to nine photos</summary>
  <description>
    <p>
      Pixlay lays photos out on a sheet: add one to nine of them, pick a layout,
      frame each photo in its cell, give the collage a frame of its own and
      export the finished image for printing.
    </p>
    <p>Features:</p>
    <ul>
      <li>Regular and irregular layouts for one to nine photos</li>
      <li>Pan, zoom and arbitrary rotation for the photo in each cell</li>
      <li>A frame with its own gap, corner radius and colour</li>
      <li>Export to PNG or JPEG at a long edge of your choice</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.yangtse.Pixlay.desktop</launchable>
  <url type="homepage">https://yangtse.org/pixlay</url>
  <url type="bugtracker">https://github.com/YangtseSu/pixlay/issues</url>
  <developer id="org.yangtse">
    <name>Yangtse Su</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>pixlay</binary>
  </provides>
  <translation type="gettext">pixlay</translation>
  <releases>
    <release version="0.1.0" date="2026-09-26"/>
  </releases>
</component>
